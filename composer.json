{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "anvil/starter-kit",
    "type": "project",
    "description": "A rock-solid Laravel 13 + Livewire 4 + Filament 5 starter kit with enforced type coverage, test coverage, and AI guidelines.",
    "keywords": ["laravel", "livewire", "filament", "starter-kit"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "livewire/flux": "^2.0",
        "nunomaduro/essentials": "^1.2"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.0",
        "driftingly/rector-laravel": "^2.0",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "@php artisan db:seed --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb923c,#86efac\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail\" \"npm run dev\" --names='server,queue,logs,vite'"
        ],
        "setup": [
            "@composer install --no-interaction",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi",
            "@php artisan db:seed --ansi",
            "npm install",
            "npm run build"
        ],
        "lint": "./vendor/bin/pint --test",
        "refactor": "./vendor/bin/rector --dry-run",
        "types": "./vendor/bin/phpstan analyse",
        "test:type-coverage": "./vendor/bin/pest --type-coverage --min=100",
        "test:unit": "./vendor/bin/pest --parallel",
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "review": [
            "@lint",
            "@refactor",
            "@types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
